# Copy to .env and use with: docker compose --env-file src/res/env/.env ...
# Keep this template free of real credentials.
KESTRA_POSTGRES_DB=kestra
KESTRA_POSTGRES_USER=kestra
KESTRA_POSTGRES_PASSWORD=replace-me
KESTRA_PORT=40770
KESTRA_MANAGEMENT_PORT=40771
KESTRA_BASIC_AUTH_USERNAME=admin@local.dev
KESTRA_BASIC_AUTH_PASSWORD=replace-me
DBT_UI_PORT=40772
DBT_UI_COMMIT=1fe89c5d023cd4d7a88642091c303a75839534f9
DBT_SNOWFLAKE_THREADS=4

# Snowflake is external. Kestra receives these as ENV_SNOWFLAKE_* process variables.
# Generate base64 SECRET_SNOWFLAKE_* values from this file with:
#   python3 src/main/kestra/encode_snowflake_secrets.py src/res/env/.env
# Add the generated assignments to .env. Keep the raw values below for dbt.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=S_CDATOS_LABORATORIOINT
SNOWFLAKE_SCHEMA=S_CDATOS_BRONZE

# Kestra OSS secret() inputs (base64 encoded; generated by the script above).
SECRET_SNOWFLAKE_ACCOUNT=
SECRET_SNOWFLAKE_USER=
SECRET_SNOWFLAKE_PASSWORD=
SECRET_SNOWFLAKE_ROLE=
SECRET_SNOWFLAKE_WAREHOUSE=
