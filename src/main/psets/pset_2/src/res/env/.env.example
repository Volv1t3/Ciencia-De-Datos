# Copy this file to .env and replace only the values intended for your account.
# This file contains local-development placeholders, never production secrets.
#? --- Kestra y su base Postgres. Uso: cp src/res/env/.env.example src/res/env/.env
#? y luego: docker compose --env-file src/res/env/.env up -d
KESTRA_POSTGRES_DB=<string>
KESTRA_POSTGRES_USER=<string>
KESTRA_POSTGRES_PASSWORD=<strong-password>
KESTRA_POSTGRES_HOST_PORT=5433
#? Usuario/clave para entrar a la UI de Kestra (http://localhost:8080).
#? Kestra 1.3 exige que el usuario sea un EMAIL valido; si no, la autenticacion queda sin
#? inicializar y la API responde 401. La clave: minimo 8 caracteres, con mayuscula y numero.
KESTRA_BASIC_AUTH_USERNAME=<email, ej. admin@example.com>
KESTRA_BASIC_AUTH_PASSWORD=<strong-password>
KESTRA_PORT=8080
KESTRA_MANAGEMENT_PORT=8081

#? --- dbt: UI web en http://localhost:5173 ; threads = modelos en paralelo.
DBT_UI_PORT=5173
DBT_UI_COMMIT=1fe89c5d023cd4d7a88642091c303a75839534f9
DBT_SNOWFLAKE_THREADS=4

#? --- Spark + Jupyter (EDA). Jupyter en http://localhost:4041 con JUPYTER_TOKEN; Spark UI en 4040.
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_UI_PORT=4040
JUPYTER_PORT=4041
JUPYTER_TOKEN=<strong-random-token>

# Headless Spark 3.5 / Snowpark Connect execution image.
#? Versiones fijadas de la imagen snowpark-connect (job de la OBT).
SNOWPARK_SPARK_VERSION=3.5.6
SNOWPARK_HADOOP_PROFILE=hadoop3
SNOWPARK_CONNECT_VERSION=1.44.0
SNOWPARK_CONNECT_VERBOSE=false

# Kestra secrets: every value must be base64 encoded without a trailing newline.
# Example: printf '%s' 'my-value' | base64
# The flow reads these as secret('SNOWFLAKE_ACCOUNT'), etc.; do not include the
# SECRET_ prefix in the flow expression.
#? Kestra OSS solo lee secretos desde variables SECRET_* codificadas en base64.
#? Identificador de cuenta Snowflake (ej. orgname-account), sin .snowflakecomputing.com.
SECRET_SNOWFLAKE_ACCOUNT=<base64-encoded-string>
SECRET_SNOWFLAKE_USER=<base64-encoded-string>
SECRET_SNOWFLAKE_PASSWORD=<base64-encoded-string>
SECRET_SNOWFLAKE_ROLE=<base64-encoded-string>
SECRET_SNOWFLAKE_WAREHOUSE=<base64-encoded-string>

# Plain Snowflake variables are consumed by dbt, Spark, and Snowpark Connect,
# not by Kestra.
SNOWFLAKE_ACCOUNT=<string>
SNOWFLAKE_USER=<string>
SNOWFLAKE_PASSWORD=<string>
SNOWFLAKE_ROLE=<string>
SNOWFLAKE_WAREHOUSE=<string>
#? Warehouse mas grande, usado solo por el job de la OBT (snowpark-connect).
SNOWFLAKE_WAREHOUSE_HIGH_COMPUTE=<string>
#? Base y esquemas por capa (medallion): Bronze (Kestra), Silver/Gold (dbt), OBT (Spark).
SNOWFLAKE_DATABASE=S_CDATOS_PSET2
SNOWFLAKE_SCHEMA=S_CDATOS_PSET2_BRONZE
SNOWFLAKE_GOLD_SCHEMA=S_CDATOS_PSET2_GOLD
SNOWFLAKE_OBT_SCHEMA=S_CDATOS_PSET2_OBT
