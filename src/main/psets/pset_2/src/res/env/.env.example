# Plantilla del README del PSet 2. Ejecutar desde src/main/psets/pset_2:
#   cp src/res/env/.env.example src/res/env/.env
# Reemplazar TODOS los valores <...> en el archivo privado, no en esta plantilla.
# Nunca subir .env ni credenciales reales. Los placeholders no autentican servicios.
# Validar sin imprimir credenciales:
#   docker compose --env-file src/res/env/.env config --quiet
# Luego: docker compose --env-file src/res/env/.env build
#        docker compose --env-file src/res/env/.env up -d

# --- PostgreSQL: estado interno de Kestra, no almacena las tablas del pipeline.
KESTRA_POSTGRES_DB=kestra
KESTRA_POSTGRES_USER=kestra
KESTRA_POSTGRES_PASSWORD=<strong-password>
KESTRA_POSTGRES_HOST_PORT=5433

# --- Kestra: UI http://127.0.0.1:8080; management en 8081.
# Sustituir por un usuario local valido para la autenticacion de Kestra.
KESTRA_BASIC_AUTH_USERNAME=<kestra-auth-username>
KESTRA_BASIC_AUTH_PASSWORD=<strong-password>
KESTRA_PORT=8080
KESTRA_MANAGEMENT_PORT=8081

# --- dbt: UI http://127.0.0.1:5173; threads = modelos en paralelo.
DBT_UI_PORT=5173
DBT_UI_COMMIT=1fe89c5d023cd4d7a88642091c303a75839534f9
DBT_SNOWFLAKE_THREADS=4

# --- Spark + Jupyter (EDA). Puertos publicados solo en 127.0.0.1.
# Jupyter http://127.0.0.1:4041; Spark UI http://127.0.0.1:4040 durante una sesion.
# Generar un token privado: openssl rand -hex 32
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_UI_PORT=4040
JUPYTER_PORT=4041
JUPYTER_TOKEN=<strong-random-token>

# --- Snowpark Connect: runtime sin puertos para construir la OBT MC1.
# Mantener estas versiones para reproducir el entorno documentado.
SNOWPARK_SPARK_VERSION=3.5.6
SNOWPARK_HADOOP_PROFILE=hadoop3
SNOWPARK_CONNECT_VERSION=1.44.0
SNOWPARK_CONNECT_VERBOSE=false

# --- Snowflake: texto plano para dbt, Spark y Snowpark Connect, no para Kestra.
# Identificador de cuenta tipo orgname-account, SIN .snowflakecomputing.com.
# Si un valor contiene $, usar comillas simples para evitar interpolacion Compose.
SNOWFLAKE_ACCOUNT=<snowflake-account>
SNOWFLAKE_USER=<snowflake-user>
SNOWFLAKE_PASSWORD='<snowflake-password>'
SNOWFLAKE_ROLE=<snowflake-role>
SNOWFLAKE_WAREHOUSE=<snowflake-warehouse>
# Warehouse dedicado al job OBT; debe existir y ser accesible por el rol.
# Compose lo asigna a SNOWFLAKE_WAREHOUSE solo en el servicio snowpark-connect.
SNOWFLAKE_WAREHOUSE_HIGH_COMPUTE=<snowflake-high-compute-warehouse>
# La base debe estar provisionada. Kestra la referencia explicitamente:
# cambiar estas variables no retargetea todo el pipeline.
SNOWFLAKE_DATABASE=S_CDATOS_PSET2
SNOWFLAKE_SCHEMA=S_CDATOS_PSET2_BRONZE
SNOWFLAKE_GOLD_SCHEMA=S_CDATOS_PSET2_GOLD
SNOWFLAKE_OBT_SCHEMA=S_CDATOS_PSET2_OBT

# --- Kestra: duplicar los cinco valores Snowflake correspondientes en base64.
# Base64 es codificacion, NO cifrado: estos valores tambien son secretos.
# Codificar el valor sin salto de linea y guardar la salida en una sola linea:
#   printf '%s' '<valor>' | base64 | tr -d '\r\n'
# SECRET_SNOWFLAKE_WAREHOUSE corresponde a SNOWFLAKE_WAREHOUSE, no al high-compute.
# El flow usa secret('SNOWFLAKE_ACCOUNT'), etc., sin el prefijo SECRET_.
SECRET_SNOWFLAKE_ACCOUNT=<base64-encoded-account>
SECRET_SNOWFLAKE_USER=<base64-encoded-user>
SECRET_SNOWFLAKE_PASSWORD=<base64-encoded-password>
SECRET_SNOWFLAKE_ROLE=<base64-encoded-role>
SECRET_SNOWFLAKE_WAREHOUSE=<base64-encoded-warehouse>
