# Copy this file to .env and replace only the values intended for your account.
# This file contains local-development placeholders, never production secrets.
KESTRA_POSTGRES_DB=<string>
KESTRA_POSTGRES_USER=<string>
KESTRA_POSTGRES_PASSWORD=<strong-password>
KESTRA_POSTGRES_HOST_PORT=<int>
KESTRA_BASIC_AUTH_USERNAME=<string>
KESTRA_BASIC_AUTH_PASSWORD=<strong-password>
KESTRA_PORT=<int>
KESTRA_MANAGEMENT_PORT=<int>

DBT_UI_PORT=<int>
DBT_UI_COMMIT=1fe89c5d023cd4d7a88642091c303a75839534f9
DBT_SNOWFLAKE_THREADS=<int>

SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# Kestra secrets: every value must be base64 encoded without a trailing newline.
# Example: printf '%s' 'my-value' | base64
# The flow reads these as secret('SNOWFLAKE_ACCOUNT'), etc.; do not include the
# SECRET_ prefix in the flow expression.
SECRET_SNOWFLAKE_ACCOUNT=<base64-encoded-string>
SECRET_SNOWFLAKE_USER=<base64-encoded-string>
SECRET_SNOWFLAKE_PASSWORD=<base64-encoded-string>
SECRET_SNOWFLAKE_ROLE=<base64-encoded-string>
SECRET_SNOWFLAKE_WAREHOUSE=<base64-encoded-string>

# Plain Snowflake variables are consumed by dbt and Spark, not by Kestra.
SNOWFLAKE_ACCOUNT=<string>
SNOWFLAKE_USER=<string>
SNOWFLAKE_PASSWORD=<string>
SNOWFLAKE_ROLE=<string>
SNOWFLAKE_WAREHOUSE=<string>
SNOWFLAKE_DATABASE=S_CDATOS_PSET2
SNOWFLAKE_SCHEMA=S_CDATOS_PSET2_BRONZE
