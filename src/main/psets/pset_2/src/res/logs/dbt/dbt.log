  as (
    

with bronze as (
    select *
    from S_CDATOS_PSET2.S_CDATOS_PSET2_BRONZE.smart_2018_raw
    
    where ingested_at > (
        select coalesce(max(bronze_ingested_at), '1900-01-01'::timestamp_ltz)
        from S_CDATOS_PSET2.S_CDATOS_PSET2_SILVER.SMART_2018
    )
    
)

select
    sha2(concat_ws('|', source_archive, source_file, source_row::varchar), 256) as silver_record_id,
    sha2(concat_ws('|', source_file, source_sha256), 256) as source_file_row_hash_key,
    try_to_number(raw_record:disk_id::varchar, 38, 0) as disk_id,
    try_to_date(raw_record:ds::varchar, 'YYYYMMDD') as observation_date,
    nullif(trim(raw_record:model::varchar), '') as model_code
    
        , try_to_decimal(raw_record:n_1::varchar, 38, 6) as n_1
        , try_to_decimal(raw_record:r_1::varchar, 38, 6) as r_1
        , try_to_decimal(raw_record:n_2::varchar, 38, 6) as n_2
        , try_to_decimal(raw_record:r_2::varchar, 38, 6) as r_2
        , try_to_decimal(raw_record:n_3::varchar, 38, 6) as n_3
        , try_to_decimal(raw_record:r_3::varchar, 38, 6) as r_3
        , try_to_decimal(raw_record:n_4::varchar, 38, 6) as n_4
        , try_to_decimal(raw_record:r_4::varchar, 38, 6) as r_4
        , try_to_decimal(raw_record:n_5::varchar, 38, 6) as n_5
        , try_to_decimal(raw_record:r_5::varchar, 38, 6) as r_5
        , try_to_decimal(raw_record:n_6::varchar, 38, 6) as n_6
        , try_to_decimal(raw_record:r_6::varchar, 38, 6) as r_6
