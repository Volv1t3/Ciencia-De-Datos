    smart.r_232
from S_CDATOS_PSET2.S_CDATOS_PSET2_SILVER.SMART_NULL_PROCESSED_ALL_YEARS as smart
inner join S_CDATOS_PSET2.S_CDATOS_PSET2_GOLD.DIM_SSD as ssd
