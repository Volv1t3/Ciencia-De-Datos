# Copiar a .env (ignorado por git) y completar. Nunca versionar el .env.

# --- Snowflake: lectura de la OBT del PSet #2 ---
SNOWFLAKE_ACCOUNT=<org-cuenta>
SNOWFLAKE_USER=<usuario>
SNOWFLAKE_PASSWORD=<password>
SNOWFLAKE_ROLE=<rol>
SNOWFLAKE_WAREHOUSE=<warehouse; usar el de alto cómputo para la extracción>
# Nombre completo BASE.ESQUEMA.TABLA. Variante elegida en la EDA (OBT_MC1_R, _N o _RN).
# Si se lee desde un share de Snowflake, la base es la del share.
OBT_TABLA=S_CDATOS_PSET2.S_CDATOS_PSET2_OBT.OBT_MC1_RN

# --- Datos locales en el H200 ---
# Carpeta del host donde vive el snapshot Parquet (~100-300 GB). Se monta en /datos.
DATOS_DIR_HOST=/ruta/en/el/h200/pset3_datos

# --- MLflow (backend store en Postgres) ---
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=<strong-password>
# En el H200 el puerto 5000 ya está ocupado por otro servicio
MLFLOW_PORT=5050
MLFLOW_EXPERIMENTO=ssd-failure-mc1

# --- JupyterLab en GPU ---
# GPUs del host para el contenedor (servidor compartido: usar solo las acordadas)
# uid del dueño del repo en el servidor (id -u); el contenedor corre con ese uid
HOST_UID=
GPU_IDS_0=0
GPU_IDS_1=1
JUPYTER_PORT=8888
JUPYTER_TOKEN=<strong-random-token>

# --- LLM por prompting (notebook 03) ---
ANTHROPIC_API_KEY=<api-key>
